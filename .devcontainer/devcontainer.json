{
  "name": "Python 3.11 (uv)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/humanizer/web/app.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "uv sync --extra dev && (cp -n .env.example .env || true)",
  "postAttachCommand": {
    "server": "uv run humanize --port 8501"
  },
  "portsAttributes": {
    "8501": {
      "label": "Humanizer",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
