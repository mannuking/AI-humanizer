# MiniMax API configuration
#
# Copy this file to .env and fill in your key:
#     cp .env.example .env
#
# The key is also read from the process environment, so a key set in the
# shell works without a .env file. The .env file is gitignored.

# --- API ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# "openai" or "anthropic". MiniMax serves both APIs; the Anthropic route
# accepts a top-level system prompt.
MINIMAX_API_STYLE=openai
MINIMAX_TIMEOUT=120
MINIMAX_MAX_RETRIES=3

# --- Rewrite behaviour ---
HUMANIZER_TEMPERATURE=0.85
HUMANIZER_TOP_P=0.95
HUMANIZER_MAX_TOKENS=8192
HUMANIZER_MAX_PASSES=3
HUMANIZER_CHUNK_CHARS=6000
HUMANIZER_TARGET_SCORE=0.25
HUMANIZER_PRESERVE_WORD_COUNT=true
HUMANIZER_WORD_COUNT_TOLERANCE=0.08

# --- Server ---
STREAMLIT_PORT=8501
